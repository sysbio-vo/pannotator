// Copyright (C) 2024 Genome Research Ltd.

// Config inheritance options
params {
    generic_config_base = "https://raw.githubusercontent.com/sanger-pathogens/nextflow-commons/"
    generic_config_version = "master"
    generic_config_url = ""
}
inherit_generic_config()

manifest {
    name            = 'pannotator'
    author          = 'IMBG & PAM Informatics'
    homePage        = 'https://github.com/sysbio-vo/pannotator'
    description     = 'Scalable pangenome-based bacterial genome annotation tool'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = 'v0.1.2'
    recurseSubmodules = true
}

params {
    // Logging options
    monochrome_logs = false

    // Input file extension
    infile_extension = "" // empty string by default - all files from the indir are considered as input

    // Output options
    outdir = "./pannotator_results"

    // Intermediate files
    save_intermediate = false

    // TODO: add debug flag that sets save_intermediate to `true` and turns on extra logging

    // Bakta settings
    bakta_db_dir = get_bakta_db_dir() // TODO: download bakta db if not found under this path
    bakta_db_type = "light" // `light|full`
    bakta_db = get_bakta_db_path()

    bakta_args = ""

    // Sequence clustering
    mmseqs_clusterPrefix = "mmseqs_clustering"
    mmseqs_tmpDir = "mmseqs_clustering"
    mmseqs_command = "easy-linclust" // TODO: allow selecting different clustering methods
    mmseqs_args = "--min-seq-id 1.0 -c 1.0"
}

process {
    // TODO: see how this matches with PaM's generic config

    errorStrategy = { (task.exitStatus in 137..140 || task.exitStatus == 130) ? 'retry' : 'terminate' }
    maxRetries = 5

    // match resource requirements from the Annotate-bakta PaM module 
    cpus = { 4 * task.attempt } // cpu_4
    memory = { 2.GB * task.attempt } // mem_2

    withName: CLUSTER_SEQS {
        cpus = { 8 * task.attempt } // cpu_8
        memory = { 8.GB * task.attempt } // mem_8
    }

    withName: ANNOTATE_PROTEINS_MODULE {
        cpus = { 48 * task.attempt } // cpu_48
        memory = { 64.GB * task.attempt } // mem_32
	time = { 2.h * task.attempt } // time_2
    }

    withName: PARSE_BAKTA_JSON_ANNOTATIONS {
        cpus = { 2 * task.attempt } // cpu_2
        memory = { 8.GB * task.attempt } // mem_8
    }

    withName: DETECT_PSEUDOGENES_MODULE {
        cpus = { 32 * task.attempt } // cpu_32
        memory = { 64.GB * task.attempt } // mem_64
    }
}



profiles {
    standard {
        process {
            withLabel:bakta {
                container = 'quay.io/d_goryslavets/bakta_pannotator:1.12.0-pannotator.2'

            }
            withLabel:clustering {
                container = 'quay.io/d_goryslavets/mmseqs2_pannotator:17-b804f-pannotator.1' 
            }

            clusterOptions = '-m "node-14-[07-09,10-20,22-27]" -G imbg-pam' // TODO: shall I use the oversubsribed queue?
        }
    }

    standard_bench_sanger {
        process {
            withLabel:bakta {
                container = 'quay.io/d_goryslavets/bakta_pannotator:1.12.0-pannotator.2'

            }
            withLabel:clustering {
                container = 'quay.io/d_goryslavets/mmseqs2_pannotator:17-b804f-pannotator.1' 
            }
	    clusterOptions = '-m "node-14-[07-09,10-20,22-27]" -G imbg-pam' // TODO: shall I use the oversubsribed queue?
        }
    }

    singularity {
        process {
            withLabel:bakta {
                container = 'quay.io/d_goryslavets/bakta_pannotator:1.12.0-pannotator.1'

            }
            withLabel:clustering {
                container = 'quay.io/d_goryslavets/mmseqs2_pannotator:17-b804f-pannotator.1' 
            }
        }

        executor {
            name = 'lsf'
            perJobMemLimit = true
        }
    }

    conda {
        process.conda = "${projectDir}/environment/pannotator.yaml"

        executor {
            name = 'lsf'
            perJobMemLimit = true
        }
    }

    local {
        executor {
            name = 'local'
        }
        process {
            cpus = 1
            memory = 4.GB
        }
    }
}

