// Helper functions
def inherit_generic_config(localConfigPath = null) {

    def configSource

    if ( localConfigPath ) {
        configSource = localConfigPath
    } else {
        configSource = params.generic_config_url ? params.generic_config_url : "${params.generic_config_base}/${params.generic_config_version}/configs/nextflow.config"
    }

    try {
        includeConfig "${configSource}"
    } catch (Exception e) {
        System.err.println("ERROR: Could not load generic config: ${config_url}")
        System.err.println("Encountered the following exception:")
        throw e
    }
}

def get_absolute_path(relative_path) {
    def relative_file = new File(relative_path)
    def absolute_path = relative_file.getAbsolutePath()
    return "${absolute_path}"
}

def get_bakta_db_dir() {
    def default_dir = "bakta_db"
    return get_absolute_path(default_dir)
}

def get_bakta_db_path() {
    if ( params.bakta_db_type == 'light' ) {
        relative_db_path = "${bakta_db_dir}/db-light"
    } else if ( params.bakta_db_type == 'full' ) {
        relative_db_path = "${bakta_db_dir}/db"
    }
    else {
        System.err.println("ERROR: Bakta database type ${params.bakta_db_type} is not recognised")
        throw new IllegalArgumentException("ERROR: Bakta database type ${params.bakta_db_type} is not recognised")
    }

    def absolutePath = get_absolute_path(relative_db_path)

    return "${absolutePath}"
}
