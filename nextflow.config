// Copyright (C) 2024 Genome Research Ltd.

// Config inheritance options
params {
    generic_config_base = "https://raw.githubusercontent.com/sanger-pathogens/nextflow-commons/"
    generic_config_version = "master"
    generic_config_url = ""
}
inherit_generic_config()

manifest {
    name            = 'pannotator'
    author          = 'IMBG & PAM Informatics'
    homePage        = 'https://github.com/sysbio-vo/pannotator'
    description     = 'Scalable pangenome-based bacterial genome annotation tool'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = 'v0.0.1'
    recurseSubmodules = true
}

params {
    // Logging options
    monochrome_logs = false

    // Output options
    outdir = "./pannotator_results"

    // Intermediate files
    save_intermediate = false

    // TODO: add debug flag that sets save_intermediate to `true` and turns on extra logging

    // Bakta settings
    bakta_db_dir = get_bakta_db_dir() // TODO: download bakta db if not found under this path
    bakta_db_type = "light" // `light|full`
    bakta_db = get_bakta_db_path()

    bakta_args = ""

    // Sequence clustering
    params.mmseqs_clusterPrefix = "mmseqs_clustering"
    params.mmseqs_tmpDir = "mmseqs_clustering"
    params.mmseqs_command = "easy-linclust" // TODO: allow selecting different clustering methods
    params.mmseqs_args = "--min-seq-id 1"     
}

process {
    maxRetries = params.max_retries

    withName: 'CLUSTER_SEQS|ANNOTATE_PROTEINS' {
        cpus = Runtime.runtime.availableProcessors()
    }
    executor = 'local'
}

